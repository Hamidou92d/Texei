<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Weather Widget</masterLabel>
    <description>Current weather (GeoNames) for a city, coordinates, the user location or an Account.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property name="hideSendButton" type="Boolean" default="false" label="Hide the send-report button"/>
            <property name="disableGeolocation" type="Boolean" default="false" label="Do not use browser geolocation"/>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <!-- Public/guest page: the send-report button is hidden by default so an
                 anonymous visitor can never trigger a mass email to org users or an
                 account's contacts. An admin can still opt in explicitly per page. -->
            <property name="hideSendButton" type="Boolean" default="true" label="Hide the send-report button"/>
            <property name="disableGeolocation" type="Boolean" default="false" label="Do not use browser geolocation"/>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
            </objects>
            <property name="hideSendButton" type="Boolean" default="false" label="Hide the send-report button"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>